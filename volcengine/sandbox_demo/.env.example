# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# The agent loads `.env` automatically at startup (see consts.py). Values in
# `.env` take precedence over variables exported in the shell; anything not set
# here falls back to the shell environment. The file is optional.
#
# `.env` is only used for local runs; for cloud deploys pass values through
# `agentkit config --runtime_envs ...` (see the README).

# --- Required -----------------------------------------------------------------
# Volcano Engine access key / secret key
VOLCENGINE_ACCESS_KEY={{your_access_key}}
VOLCENGINE_SECRET_KEY={{your_secret_key}}
# TOS bucket used to deliver generated projects
DATABASE_TOS_BUCKET=agentkit-platform-{{your_account_id}}
# Volcano Engine Ark (方舟) API key (required for local debugging)
MODEL_AGENT_API_KEY={{your_model_agent_api_key}}
# AIO Sandbox tool id (from `agentkit tool create`)
AGENTKIT_TOOL_ID={{your_sandbox_tool_id}}
