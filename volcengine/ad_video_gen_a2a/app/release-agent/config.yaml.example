model:
  agent:
    provider: openai
    # name: doubao-seed-2-1-turbo-260628 # vision-capable alternative
    name: deepseek-v4-pro-260425
    api_base: https://ark.cn-beijing.volces.com/api/v3/
    api_key:
  format:
    # Formatting is text-only; point this at a cheaper model if you have one enabled
    name: deepseek-v4-pro-260425


shorten_url_service_url: http://127.0.0.1:8005
volcengine:
  # Local composition is the default; only needed when switching to
  # cloud-based (VOD) video composition
  access_key:
  secret_key:

tools:
  # Local composition is the default; only needed when switching to
  # cloud-based (VOD) video composition
  vod:
    space_name:
    task_polling_interval: 20
    max_retries: 60


logging:
  # ERROR
  # WARNING
  # INFO
  # DEBUG
  level: DEBUG

thinking:
  release_agent: disabled
  audio_agent: disabled
  film_agent: disabled
  format_agent: disabled
