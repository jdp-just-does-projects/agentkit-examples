model:
  agent:
    provider: openai
    # name: doubao-seed-2-1-turbo-260628 # vision-capable alternative
    name: deepseek-v4-pro-260425
    api_base: https://ark.cn-beijing.volces.com/api/v3/
    api_key:
  video:
    name: doubao-seedance-2-5-260628
    api_base: https://ark.cn-beijing.volces.com/api/v3/
    api_key:
  image:
    name: doubao-seedream-5-0-pro-260628
    api_base: https://ark.cn-beijing.volces.com/api/v3/
    api_key:
  format:
    # Formatting is text-only; point this at a cheaper model if you have one enabled
    name: deepseek-v4-pro-260425

logging:
  # ERROR
  # WARNING
  # INFO
  # DEBUG
  level: DEBUG

thinking:
  director_agent: disabled
  storyboard_agent: enabled
  story_format_agent: disabled
  image_agent: enabled
  image_format_agent: disabled
  video_agent: enabled
  video_format_agent: disabled
