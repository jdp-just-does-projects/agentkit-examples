model:
  agent:
    provider: openai
    name: deepseek-v4-pro-260425
    api_base: https://ark.cn-beijing.volces.com/api/v3/
    # Required, but usually supplied as MODEL_AGENT_API_KEY through `.env` or
    # the shell, which wins over config.yaml. Set it here only if you prefer to
    # keep it in this file - and never leave the key present but blank: veadk
    # exports every config.yaml key it reads, and a blank value becomes the
    # literal string "None", which is then sent as the API key (a 401 instead
    # of veadk's clear "not set" error).
    # api_key: <your model API key>
  # [optional] vision-capable model used by the image-understanding and
  # image-filter tools (they look at product images); defaults to
  # doubao-seed-2-1-turbo-260628 when unset.
  # vision:
  #   name: doubao-seed-2-1-turbo-260628

# [optional] credentials for Viking DB and the `web_search` tool.
# Leave the whole block commented out rather than present with blank values -
# veadk exports every config.yaml key it reads, and a blank value is exported
# as the literal string "None" rather than staying unset, so callers receive
# "None" instead of an absent variable. A value in `.env` or the shell still
# wins over config.yaml, so this only bites when the key is set nowhere else.
# volcengine:
#   access_key: <your access key>
#   secret_key: <your secret key>

logging:
  # ERROR
  # WARNING
  # INFO
  # DEBUG
  level: DEBUG

thinking:
  market_agent: disabled
  format_agent: disabled
