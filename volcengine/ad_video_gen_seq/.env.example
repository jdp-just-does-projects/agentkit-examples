# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# The agent loads `.env` automatically at startup (see consts.py). Values in
# `.env` take precedence over variables exported in the shell; anything not set
# here falls back to the shell environment. The file is optional.
#
# The agentkit CLI (`agentkit config` / `launch` / `invoke` / `destroy`) also
# reads VOLCENGINE_ACCESS_KEY / VOLCENGINE_SECRET_KEY from the `.env` in the
# directory you run it from, so you do not have to export them in your shell.
# Note the CLI's precedence is the reverse of the agent's: for the CLI, an AK/SK
# exported in the shell, an `agentkit login` SSO session, or a key saved via
# `agentkit config --global --set volcengine.access_key=... --set
# volcengine.secret_key=...` all win over `.env`.
#
# Nothing in `.env` is forwarded to the deployed runtime. Values the runtime
# needs must be passed through `agentkit config --runtime_envs ...` (see the
# README); the runtime obtains its own AK/SK from its IAM role.

# --- Required -----------------------------------------------------------------
# Volcano Engine Ark (方舟) API key
MODEL_AGENT_API_KEY={{your_model_agent_api_key}}
# Volcano Engine access key / secret key (TOS upload); also used by the
# agentkit CLI for deployments (see header note)
VOLCENGINE_ACCESS_KEY={{your_access_key}}
VOLCENGINE_SECRET_KEY={{your_secret_key}}
# TOS bucket for generated assets
DATABASE_TOS_BUCKET=agentkit-platform-{{your_account_id}}

# --- Optional (defaults shown) --------------------------------------------------
# MODEL_AGENT_NAME=doubao-seed-2-1-turbo-260628
# MODEL_EVALUATE_NAME=doubao-seed-2-1-turbo-260628
# MODEL_IMAGE_NAME=doubao-seedream-5-0-pro-260628
# MODEL_VIDEO_NAME=doubao-seedance-2-5-260628
