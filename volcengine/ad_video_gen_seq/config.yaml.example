# Copy this file to `config.yaml` and fill in the empty values.
# Keys are flattened into environment variables by VeADK, e.g.
# model.agent.name -> MODEL_AGENT_NAME. Environment variables that are
# already set take precedence over the values in this file.
model:
  agent:
    provider: openai
    name: doubao-seed-2-1-turbo-260628    # Must be a vision-capable model (the market agent reads product images)
    api_base: https://ark.cn-beijing.volces.com/api/v3/
    api_key:
  image:
    name: doubao-seedream-5-0-pro-260628
    api_base: https://ark.cn-beijing.volces.com/api/v3/
  video:
    name: doubao-seedance-2-5-260628    # Seedance 2.5 supports 4-30 second clips
    api_base: https://ark.cn-beijing.volces.com/api/v3/
  evaluate:
    name: doubao-seed-2-1-turbo-260628    # Must be a model that supports image input

# Volcano Engine AK/SK, used for TOS upload authentication.
# Note: delete this whole section (instead of leaving the values empty) if you
# want to rely on the runtime IAM role when deployed to AgentKit.
volcengine:
  access_key:
  secret_key:

# TOS bucket used to store the final merged video,
# e.g. agentkit-platform-{{your_account_id}}
database:
  tos:
    bucket:
