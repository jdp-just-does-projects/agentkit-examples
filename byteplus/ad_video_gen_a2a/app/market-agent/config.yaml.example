model:
  agent:
    provider: openai
    name: deepseek-v4-pro-260425
    api_base: https://ark.ap-southeast.bytepluses.com/api/v3
    # Required, but usually supplied as MODEL_AGENT_API_KEY through `.env` or
    # the shell, which wins over config.yaml. Set it here only if you prefer to
    # keep it in this file - and never leave the key present but blank: veadk
    # exports every config.yaml key it reads, and a blank value becomes the
    # literal string "None", which is then sent as the API key (a 401 instead
    # of veadk's clear "not set" error).
    # api_key: <your model API key>
  # [optional] vision-capable model used by the image-understanding and
  # image-filter tools (they look at product images); defaults to
  # dola-seed-2-1-turbo-260628 when unset.
  # vision:
  #   name: dola-seed-2-1-turbo-260628

logging:
  # ERROR
  # WARNING
  # INFO
  # DEBUG
  level: DEBUG

thinking:
  market_agent: disabled
  format_agent: disabled
