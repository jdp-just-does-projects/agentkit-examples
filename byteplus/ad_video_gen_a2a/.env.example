# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# The agent loads `.env` automatically at startup (see consts.py). Values in
# `.env` take precedence over variables exported in the shell; anything not set
# here falls back to the shell environment. The file is optional.
#
# `.env` is only used for local runs; for cloud deploys pass values through
# `agentkit config --runtime_envs ...` (see the README).

# Every service loads this shared file (project root); a service may also
# have its own `.env` next to its config.yaml or in its src/ dir, which wins
# for keys present in both.

# --- Required -----------------------------------------------------------------
# Both are mandatory: AGENTKIT_CLOUD_PROVIDER is read by the agentkit SDK,
# CLOUD_PROVIDER by veADK (endpoints, models, BYTEPLUS_* -> VOLCENGINE_* mapping).
AGENTKIT_CLOUD_PROVIDER=byteplus
CLOUD_PROVIDER=byteplus

# BytePlus ModelArk API key
MODEL_AGENT_API_KEY={{your_model_agent_api_key}}
# BytePlus access key / secret key (TOS image upload, director agent)
BYTEPLUS_ACCESS_KEY={{your_access_key}}
BYTEPLUS_SECRET_KEY={{your_secret_key}}
# TOS bucket for generated assets
DATABASE_TOS_BUCKET=agentkit-platform-{{your_account_id}}
# BytePlus Searchinfinity key, required by the market agent's web_search tool
BYTEPLUS_WEB_SEARCH_API_KEY={{your_web_search_api_key}}

# --- Optional (defaults shown; also settable per service in config.yaml) -------
# MODEL_AGENT_NAME=deepseek-v4-pro-260425
# MODEL_VISION_NAME=dola-seed-2-1-turbo-260628
# MODEL_EVALUATE_ITEM=dola-seed-2-1-turbo-260628
# MODEL_IMAGE_NAME=dola-seedream-5-0-pro-260628
# MODEL_VIDEO_NAME=dreamina-seedance-2-5-260628
# short_link service
# SHORT_LINK_MODE=dict             # dict | redis
# SHORT_LINK_DOMAIN=http://localhost:8005
